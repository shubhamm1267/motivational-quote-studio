
{
  "name": "motivational-quote-studio",
  "version": "5.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "api": "node backend/server.mjs",
    "worker": "python -m uvicorn main:app --app-dir worker --host 127.0.0.1 --port 8008",
    "web": "npm --prefix frontend start",
    "test": "node --test tests/*.test.mjs && python -m pytest -q worker/test_render.py",
    "setup:frontend": "node scripts/install-frontend.mjs"
  }
}
